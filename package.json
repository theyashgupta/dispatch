{
  "name": "@theyashgupta/dispatch",
  "version": "4.0.0",
  "description": "A local kanban board that turns Linear tickets into live Claude Code agent sessions - one git worktree per ticket, real terminals in the browser.",
  "keywords": [
    "kanban",
    "linear",
    "claude-code",
    "agent",
    "tmux",
    "ttyd",
    "worktree",
    "cli",
    "localhost"
  ],
  "license": "MIT",
  "author": "Yash Gupta",
  "homepage": "https://github.com/theyashgupta/dispatch#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/theyashgupta/dispatch.git"
  },
  "bugs": {
    "url": "https://github.com/theyashgupta/dispatch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": {
    "dispatch": "dist/server/bootstrap/cli.js"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch src/server/bootstrap/index.ts\" \"vite\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "test": "node --import tsx --test 'src/server/**/*.test.ts' 'src/shared/**/*.test.ts' && TSX_TSCONFIG_PATH=src/web/tsconfig.json node --import tsx --test 'src/web/**/*.test.ts' && node --import tsx --test 'eslint-local/**/*.test.ts'",
    "terminal-e2e": "node scripts/terminal-appearance-e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "depcruise": "depcruise src",
    "lint:fix": "eslint . --fix",
    "deadcode": "knip && knip --production",
    "build:web": "vite build",
    "analyze": "ANALYZE=1 vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "build": "npm run build:web && npm run build:server",
    "start": "NODE_ENV=production node dist/server/bootstrap/index.js",
    "replay-gate": "tsx scripts/replay-watcher.ts --check",
    "doc-drift": "node scripts/check-doc-drift.mjs",
    "invariants": "node scripts/check-invariants.mjs",
    "check-hooks": "node scripts/check-hooks.mjs",
    "check:static": "npm run format:check && npm run lint && npm run typecheck && npm run depcruise && npm run deadcode",
    "selection-guard": "tsx scripts/terminal-selection-guard.ts",
    "sim": "node scripts/fresh-env-sim.mjs",
    "migration-diff": "node scripts/migration-diff-v3.mjs",
    "downgrade-guard": "node scripts/downgrade-guard-v3.mjs",
    "redaction-capture": "node scripts/redaction-capture-v3.mjs",
    "reinstall-sim": "node scripts/reinstall-sim.mjs",
    "panel-98": "node scripts/panel-98.mjs",
    "gh-reliability-98": "node scripts/gh-reliability-98.mjs",
    "panel-99": "node scripts/panel-99.mjs",
    "port-attribution-99": "node scripts/port-attribution-99.mjs",
    "panel-100": "node scripts/panel-100.mjs",
    "mobile-term-101": "node scripts/mobile-term-101.mjs",
    "mobile-term-101.1": "node scripts/mobile-term-101.mjs --check pty-shim && node scripts/mobile-term-101.mjs --check local-scroll && node scripts/mobile-term-101.mjs --check seed",
    "panel-104": "node scripts/panel-104.mjs",
    "panel-112": "node scripts/panel-112.mjs",
    "contrast-113": "node scripts/contrast-113.mjs",
    "panel-114": "node scripts/panel-114.mjs",
    "panel-115": "node scripts/panel-115.mjs",
    "check": "npm run format:check && npm run lint && npm run depcruise && npm run typecheck && npm run test && npm run deadcode && npm run replay-gate && npm run doc-drift && npm run invariants && npm run check-hooks",
    "prepack": "npm run build"
  },
  "dependencies": {
    "express": "5.2.1",
    "uqr": "0.1.3",
    "write-file-atomic": "8.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/hast": "3.0.4",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/write-file-atomic": "4.0.3",
    "@vitejs/plugin-react": "6.0.3",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "10.0.3",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.0.1",
    "eslint-plugin-check-file": "3.3.1",
    "eslint-plugin-jsdoc": "63.0.12",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "knip": "6.24.0",
    "lucide-react": "1.23.0",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.3"
  }
}
