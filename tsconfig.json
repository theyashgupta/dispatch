{
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/web/*"]
    }
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests"],
  "exclude": ["src/web"]
}
